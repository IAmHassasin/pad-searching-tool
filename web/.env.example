# Production: full API origin (Cloudflare-cached JSON + API).
# Dev: leave unset — Vite proxies to localhost:3000.
# Set real values in `web/.env` (gitignored).
# VITE_API_BASE=https://api.example.com

# PAD media CDN (zero-padded monster_id, e.g. 1234 → 01234.png).
# VITE_PAD_CDN_ORIGIN=https://cdn.example.com/media
# VITE_PORTRAIT_CDN_BASE=.../portraits
# VITE_ICON_CDN_BASE=.../icons

# Translate page OCR (tesseract.js). Unset = the library's CDN defaults (jsDelivr worker/core,
# tessdata language files). Point these at self-hosted copies to avoid third-party CDNs.
# VITE_TESSERACT_WORKER_PATH=https://cdn.example.com/tesseract/worker.min.js
# VITE_TESSERACT_CORE_PATH=https://cdn.example.com/tesseract/tesseract-core-simd-lstm.wasm.js
# VITE_TESSERACT_LANG_PATH=https://cdn.example.com/tessdata
